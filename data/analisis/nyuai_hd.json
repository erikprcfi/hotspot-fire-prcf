as akhir) (tC/ha) × 44/12. Kelas awal periode: Peta Penutupan Lahan resmi KLHK (1:250.000) tahun awal periode (atau tahun terdekat sebelumnya); luas awal = luas kelas pada peta itu dikurangi kehilangan antara tahun peta dan tahun awal. Bila peta KLHK tidak tersedia: GLCLU epoch terakhir sebelum tahun awal periode (pohon > 25 m = primer, 3–25 m = sekunder; lahan kering / rawa); luas awal = luas kelas pada epoch itu dikurangi kehilangan sebelum tahun awal. Kehilangan di hutan primer = degradasi (→ sekunder); di hutan sekunder = deforestasi (→ PLK bercampur semak / belukar rawa). Kehilangan di piksel yang bukan hutan menurut GLCLU dicatat terpisah dan tidak dihitung sebagai emisi.","kepadatan_karbon_tC_ha":{"hlk_primer":{"nama":"Hutan Lahan Kering Primer","tC_ha":197.59},"hlk_sekunder":{"nama":"Hutan Lahan Kering Sekunder","tC_ha":135.15},"hr_primer":{"nama":"Hutan Rawa Primer","tC_ha":163.47},"hr_sekunder":{"nama":"Hutan Rawa Sekunder","tC_ha":123.69},"plk_semak":{"nama":"Pertanian Lahan Kering Bercampur Semak","tC_ha":36.45},"belukar_rawa":{"nama":"Belukar Rawa","tC_ha":11.24}},"faktor_emisi":[{"awal":"Hutan Lahan Kering Primer","akhir":"Hutan Lahan Kering Sekunder","jenis":"degradasi","selisih_tC_ha":62.44,"tCO2e_ha":228.95},{"awal":"Hutan Lahan Kering Sekunder","akhir":"Pertanian Lahan Kering Bercampur Semak","jenis":"deforestasi","selisih_tC_ha":98.7,"tCO2e_ha":361.9},{"awal":"Hutan Rawa Primer","akhir":"Hutan Rawa Sekunder","jenis":"degradasi","selisih_tC_ha":39.78,"tCO2e_ha":145.86},{"awal":"Hutan Rawa Sekunder","akhir":"Belukar Rawa","jenis":"deforestasi","selisih_tC_ha":112.45,"tCO2e_ha":412.32}],"sumber_kelas":"KLHK","aturan_tahun_peta":"tahun_awal","dasar":{"2020":{"luas_ha":[0.0,3726.3362,0.0,0.0],"hilang_ha":{"2001":[0.0,0.0,0.0,0.0,3.9411],"2002":[0.0,0.0,0.0,0.0,7.2639],"2003":[0.0,0.0773,0.0,0.0,3.4001],"2004":[0.0,0.2318,0.0,0.0,5.7184],"2006":[0.0,0.6182,0.0,0.0,0.0],"2007":[0.0,0.3091,0.0,0.0,0.5409],"2008":[0.0,0.0773,0.0,0.0,2.6274],"2009":[0.0,0.3