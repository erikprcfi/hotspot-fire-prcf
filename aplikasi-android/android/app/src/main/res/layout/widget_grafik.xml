<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/g_akar" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/w_latar">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/g_angka" style="@style/WTeks.Tebal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="40sp" />
      <TextView android:id="@+id/g_sub" style="@style/WTeks.Redup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/g_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w_chip" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textColor="#0B3B2C" android:textStyle="bold" android:textSize="13sp" android:maxLines="1" />
  </LinearLayout>
  <ImageView android:id="@+id/g_grafik" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:scaleType="fitXY" android:contentDescription="@null" />
  <TextView android:id="@+id/g_waktu" style="@style/WTeks.Redup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:layout_marginTop="4dp"/>
</LinearLayout>
